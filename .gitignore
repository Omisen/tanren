# Claude / project docs (non versionati)
CLAUDE.md

# Wiki di GitHub: e' un repository git a se', clonato qui dentro per comodita'.
# Va versionata sul suo remote (tanren.wiki.git), non dentro questo repo.
wiki/*.md

# Riferimenti di design (file DESIGN.md presi da getdesign.md): materiale personale
# di ispirazione, non fa parte del progetto. La regola su come vanno usati sta nel
# README della cartella e in CLAUDE.md, sezione "4. Design principles".
design-references/

# Materia prima del ritaglio del font: `tools/font/generate.py` la scarica e la
# cancella da se'. Resta solo se lo script muore a meta', e sono megabyte.
public/fonts/*-intero.ttf

# Node
node_modules/
dist/
dist-ssr/
*.local
.vite/

# Rust / Tauri
target/
**/target/
# Solo gli schemi generati: il progetto Android in gen/android e' versionato,
# perche' le modifiche al manifest (per esempio la tastiera IME) sono codice
# e non devono vivere solo su un disco. Gli artefatti di build li escludono i
# .gitignore che Tauri stesso mette dentro gen/android.
src-tauri/gen/schemas/

# Android
.gradle/
*.apk
*.aab
local.properties

